<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VisioForge.MCP.Shared\VisioForge.MCP.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Data/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Served as /.well-known/mcp.json; the same file is published to the MCP Registry. -->
    <Content Include="..\server.json" Link="server.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- DeploymentGuideTests compares the NugetPins constants against the release catalog. -->
    <InternalsVisibleTo Include="VisioForge.MCP.Tests" />
  </ItemGroup>
</Project>
